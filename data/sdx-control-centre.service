[Unit]
Description=SDX Control Centre hardware service
Documentation=https://github.com/linux-surface/linux-surface
After=dbus.service polkit.service

[Service]
Type=dbus
BusName=org.sdxcontrolcentre.Daemon
ExecStart=/usr/bin/sdx-control-centred
Restart=on-failure
ProtectHome=yes

[Install]
WantedBy=multi-user.target
